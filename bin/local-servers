#!/usr/bin/env bash
# Local Model Runner
# Interactive menu: pick options while the terminal stays open.
# Quit with q or Ctrl+C.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Use LIVEAI_DIR if set, otherwise derive from SCRIPT_DIR
LIVEAI_DIR="${LIVEAI_DIR:-$(dirname "$SCRIPT_DIR")}"

source "$LIVEAI_DIR/.liveai-cpu/bin/activate"

echo "--------------------------------------------------"
echo "Local Model Runner"
echo "Interactive menu: pick options while the terminal"
echo "stays open. Quit with q or Ctrl+C."
echo "--------------------------------------------------"

python "$LIVEAI_DIR/samples/local_model_runner.py" -i "$@"

read -p "Press Enter to continue..."