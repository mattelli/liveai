#!/usr/bin/env bash
# ============================================
# Live Assistant - Interactive Chat Launcher
# ============================================
# Activates the .liveai-cpu virtual environment and runs main.py --chat

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

source "../.liveai-cpu/bin/activate"

echo "Loading Agent ..."
python "../main.py" "--chat" "$@"